@{
    Layout = null;
    ViewData["Title"] = "Manage your booking";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>Manage your booking</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #172033; background: #f4f6fa; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; box-sizing: border-box; }
        main { width: min(100%, 620px); background: white; border: 1px solid #e4e8ef; border-radius: 18px; padding: clamp(24px, 5vw, 44px); box-shadow: 0 18px 55px #18274612; }
        h1 { margin: 0 0 8px; font-size: clamp(26px, 5vw, 34px); letter-spacing: -.04em; }
        p { color: #566176; line-height: 1.6; }
        dl { display: grid; grid-template-columns: 1fr auto; gap: 14px; margin: 28px 0; }
        dt { color: #667085; } dd { margin: 0; font-weight: 600; text-align: right; }
        .actions { display: flex; gap: 12px; flex-wrap: wrap; }
        button { border: 0; border-radius: 10px; padding: 12px 18px; font: inherit; font-weight: 650; cursor: pointer; }
        button:focus-visible { outline: 3px solid #90b7ff; outline-offset: 2px; }
        #cancel { color: white; background: #b42318; } #cancel:disabled { opacity: .55; cursor: wait; }
        #status { min-height: 1.5em; } [hidden] { display: none !important; }
    </style>
</head>
<body>
<main aria-labelledby="title">
    <h1 id="title">Manage your booking</h1>
    <p id="status" role="status" aria-live="polite">Loading booking details…</p>
    <dl id="details" hidden>
        <dt>Reference</dt><dd id="reference"></dd>
        <dt>Stay or event</dt><dd id="dates"></dd>
        <dt>Quantity</dt><dd id="quantity"></dd>
        <dt>Total</dt><dd id="total"></dd>
        <dt>Status</dt><dd id="booking-status"></dd>
    </dl>
    <div class="actions"><button id="cancel" type="button" hidden>Cancel booking</button></div>
</main>
<script>
(() => {
    const status = document.getElementById('status');
    const details = document.getElementById('details');
    const cancel = document.getElementById('cancel');
    const reference = new URLSearchParams(location.search).get('reference');
    const token = new URLSearchParams(location.hash.slice(1)).get('token');
    history.replaceState(null, '', location.pathname + location.search);

    if (!reference || !token) {
        status.textContent = 'This management link is incomplete. Use the full link from your booking confirmation email.';
        return;
    }

    const headers = { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' };
    const endpoint = `/api/bookings/${encodeURIComponent(reference)}`;
    const put = (id, value) => { document.getElementById(id).textContent = value ?? ''; };

    fetch(endpoint, { headers, credentials: 'same-origin', cache: 'no-store' })
        .then(async response => {
            if (!response.ok) throw new Error(response.status === 404 ? 'Booking not found or this link is invalid.' : 'Could not load booking details.');
            return response.json();
        })
        .then(booking => {
            put('reference', booking.bookingReference);
            put('dates', booking.checkOut ? `${new Date(booking.checkIn).toLocaleDateString()} – ${new Date(booking.checkOut).toLocaleDateString()}` : new Date(booking.checkIn).toLocaleDateString());
            put('quantity', String(booking.quantity));
            put('total', `${booking.currency} ${Number(booking.totalPrice).toFixed(2)}`);
            put('booking-status', booking.status);
            details.hidden = false;
            status.textContent = booking.status === 'Cancelled' ? 'This booking has been cancelled.' : 'Review your booking details below.';
            cancel.hidden = booking.status === 'Cancelled';
        })
        .catch(error => { status.textContent = error.message; });

    cancel.addEventListener('click', async () => {
        if (!confirm('Cancel this booking? This action cannot be undone.')) return;
        cancel.disabled = true;
        try {
            const response = await fetch(`${endpoint}/cancel`, { method: 'POST', headers, credentials: 'same-origin', cache: 'no-store' });
            if (!response.ok) throw new Error(response.status === 404 ? 'Booking not found or this link is invalid.' : 'Cancellation failed. Please try again.');
            status.textContent = 'Your booking has been cancelled.';
            put('booking-status', 'Cancelled');
            cancel.hidden = true;
        } catch (error) {
            status.textContent = error.message;
            cancel.disabled = false;
        }
    });
})();
</script>
</body>
</html>
