@{
    ViewData["Title"] = "Universal Imports";
    Layout = "~/Views/Layouts/SiteKitStudio.cshtml";
}
<main class="ski" id="sitekit-imports">
    <header><div><small>SITEKIT STUDIO</small><h1>Universal data imports</h1><p>Map CSV, JSON or XML files, or an allowlisted JSON REST source, into persistent SiteKit business entities. Preview first, then run a permission-checked import.</p></div></header>
    <div class="grid"><aside><label>Project<select id="project"></select></label><h2>Saved mappings</h2><div id="mappings" aria-live="polite">Select a project</div><button id="new-mapping" type="button">New mapping</button></aside><section><form id="mapping-form"><h2>Mapping definition</h2><label>Name<input name="name" required maxlength="120"></label><label>Alias<input name="alias" required pattern="[a-z][a-z0-9-]{1,63}"></label><label>Target entity<select name="entity" required></select></label><label>Format<select name="format"><option value="csv">CSV</option><option value="json">JSON</option><option value="xml">XML</option></select></label><label>Optional JSON REST source URL (HTTPS, allowlisted host only)<input name="sourceUrl" type="url" inputmode="url" placeholder="https://api.example.com/customers"></label><label class="check"><input type="checkbox" name="header" checked> CSV has a header row</label><label>Source-to-entity field mapping (JSON)<textarea name="fields" rows="5" required placeholder='{"email":"email","name":"name"}'></textarea></label><label>Unique match fields (comma separated entity aliases)<input name="matchFields" required placeholder="email"></label><button type="submit">Save mapping</button><p id="mapping-status" role="status"></p></form><form id="upload-form"><h2>Preview and import</h2><label>Data file<input type="file" name="file" accept=".csv,.json,.xml,text/csv,application/json,application/xml,text/xml"></label><p>Use a file or the mapping's configured REST source. REST sources must be configured in <code>SiteKit:Import:AllowedHosts</code>.</p><div class="buttons"><button type="button" id="preview">Preview</button><button type="button" id="run" class="primary">Run import</button></div><p id="upload-status" role="status"></p><pre id="result" aria-live="polite"></pre></form><section><h2>Recent activity</h2><div id="run-history" aria-live="polite">Select a mapping to view import history.</div></section></section></div>
</main>
<style>
.ski{max-width:1200px;margin:2rem auto;padding:0 1.5rem;color:#17212b;font:15px/1.5 system-ui,sans-serif}.ski *{box-sizing:border-box}.ski header{border-bottom:1px solid #dce3e8;padding-bottom:1rem}.ski small{color:#087f8c;letter-spacing:.12em;font-weight:700}.ski h1{margin:.15rem 0;font-size:2rem}.ski p{color:#64727b}.ski a{color:#087f8c}.ski .grid{display:grid;grid-template-columns:minmax(230px,300px) 1fr;gap:1rem;margin-top:1.2rem}.ski aside,.ski section{border:1px solid #dce3e8;border-radius:12px;padding:1.2rem;min-width:0}.ski form{border:1px solid #e4eaee;border-radius:9px;padding:1rem;margin-bottom:1rem}.ski label{display:grid;gap:.3rem;margin:.7rem 0;font-weight:600}.ski label.check{display:flex;align-items:center}.ski input,.ski select,.ski textarea{font:inherit;width:100%;padding:.6rem;border:1px solid #b8c5cc;border-radius:7px}.ski input[type=checkbox]{width:auto}.ski button{font:inherit;padding:.6rem .9rem;border:1px solid #b8c5cc;border-radius:7px;background:#fff;cursor:pointer}.ski button:focus-visible,.ski input:focus-visible,.ski select:focus-visible,.ski textarea:focus-visible{outline:3px solid #68c9d0;outline-offset:2px}.ski .primary{background:#087f8c;color:white;border-color:#087f8c}.ski .item{display:block;width:100%;text-align:left;margin:.4rem 0}.ski .buttons{display:flex;gap:.5rem}.ski pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f6f8f9;padding:.8rem;border-radius:7px}@@media(max-width:700px){.ski .grid{grid-template-columns:1fr}}
</style>
<script>
(()=>{const api='/api/sitekit',project=document.getElementById('project'),mappings=document.getElementById('mappings'),form=document.getElementById('mapping-form'),upload=document.getElementById('upload-form'),status=document.getElementById('mapping-status'),uploadStatus=document.getElementById('upload-status'),result=document.getElementById('result'),history=document.getElementById('run-history');let current=null,entities=[];
async function req(url,options={}){const response=await fetch(url,options);if(!response.ok){const body=await response.json().catch(()=>({}));throw new Error(body.title||body.error||`Request failed (${response.status})`)}return response.status===204?null:response.json()}
async function loadMappings(){if(!current)return;const rows=await req(`${api}/projects/${encodeURIComponent(current)}/imports`);mappings.innerHTML=rows.map(m=>`<button type="button" class="item" data-alias="${m.alias}">${m.name} · ${m.sourceUrl?'REST':'file '+m.format}</button>`).join('')||'<p>No mappings saved.</p>';mappings.querySelectorAll('[data-alias]').forEach(button=>button.onclick=()=>edit(rows.find(m=>m.alias===button.dataset.alias)))}
async function loadHistory(alias){try{const rows=await req(`${api}/projects/${encodeURIComponent(current)}/imports/${encodeURIComponent(alias)}/runs`);history.innerHTML=rows.map(run=>`<article class="run"><strong>${run.mode} · ${run.status}</strong><small>${new Date(run.startedAt).toLocaleString()} · ${run.actor}</small><span>${run.rowsRead} rows · ${run.created} created · ${run.updated} updated · ${run.errorCount} errors</span><code>SHA-256 ${run.contentSha256}</code></article>`).join('')||'<p>No import history yet.</p>'}catch(error){history.textContent=error.message}}
function edit(mapping){form.elements.name.value=mapping.name;form.elements.alias.value=mapping.alias;form.elements.entity.value=mapping.entityAlias;form.elements.format.value=mapping.format;form.elements.header.checked=mapping.hasHeader;form.elements.sourceUrl.value=mapping.sourceUrl||'';form.elements.fields.value=JSON.stringify(mapping.fields,null,2);form.elements.matchFields.value=mapping.matchFields.join(',');upload.elements.file.value='';upload.dataset.alias=mapping.alias;status.textContent='Mapping selected.';loadHistory(mapping.alias)}
async function selectProject(id){current=id;entities=await req(`${api}/projects/${encodeURIComponent(id)}/entities`);form.elements.entity.innerHTML=entities.map(e=>`<option value="${e.alias}">${e.name} · ${e.alias}</option>`).join('');await loadMappings()}
document.getElementById('new-mapping').onclick=()=>{form.reset();form.elements.header.checked=true;upload.elements.file.value='';delete upload.dataset.alias;result.textContent='';status.textContent='Create and save a mapping before previewing.'};
form.onsubmit=async event=>{event.preventDefault();try{const fields=JSON.parse(form.elements.fields.value);const sourceUrl=form.elements.sourceUrl.value.trim();const mapping={schemaVersion:1,projectId:current,alias:form.elements.alias.value,name:form.elements.name.value,entityAlias:form.elements.entity.value,fields,matchFields:form.elements.matchFields.value.split(',').map(value=>value.trim()).filter(Boolean),format:form.elements.format.value,sourceUrl:sourceUrl||null,hasHeader:form.elements.header.checked,delimiter:','};await req(`${api}/projects/${encodeURIComponent(current)}/imports/${encodeURIComponent(mapping.alias)}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(mapping)});upload.dataset.alias=mapping.alias;status.textContent='Mapping saved.';await loadMappings()}catch(error){status.textContent=error.message}};
async function submit(mode){const alias=upload.dataset.alias,file=upload.elements.file.files[0],sourceUrl=form.elements.sourceUrl.value.trim();if(!alias){uploadStatus.textContent='Save or select a mapping first.';return}if(!file&&!sourceUrl){uploadStatus.textContent='Choose a data file or configure an allowlisted REST source.';return}const body=new FormData();if(file)body.append('file',file);uploadStatus.textContent=mode==='preview'?'Validating import…':'Running import…';try{const data=await req(`${api}/projects/${encodeURIComponent(current)}/imports/${encodeURIComponent(alias)}/${mode==='preview'?'preview':'run'}`,{method:'POST',body});result.textContent=JSON.stringify(data,null,2);uploadStatus.textContent=mode==='preview'?'Preview complete. Review row errors before running.':'Import complete.';await loadHistory(alias)}catch(error){uploadStatus.textContent=error.message;await loadHistory(alias)}}
document.getElementById('preview').onclick=()=>submit('preview');document.getElementById('run').onclick=()=>submit('run');
req(`${api}/projects`).then(async rows=>{project.innerHTML=rows.map(p=>`<option value="${p.id}">${p.name} · ${p.category}</option>`).join('');if(rows.length)await selectProject(rows[0].id);else{mappings.textContent='Create a project first.'}}).catch(error=>{mappings.textContent=error.message});project.onchange=()=>selectProject(project.value).catch(error=>{mappings.textContent=error.message});
})();
</script>
