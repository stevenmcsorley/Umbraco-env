@{
    ViewData["Title"] = "Application Screens";
    Layout = "~/Views/Layouts/SiteKitStudio.cshtml";
}
<div class="sks" id="sitekit-screens">
    <header><div><small>SITEKIT STUDIO</small><h1>Application screens</h1><p>Connect tables, forms, pipelines and dashboards to persistent project data.</p></div><button class="primary" id="new-screen">New screen</button></header>
    <div class="columns"><aside><h2>Projects</h2><div id="projects" aria-live="polite">Loading…</div><h2>Screens</h2><div id="screen-list" aria-live="polite">Select a project</div></aside><main><section id="empty"><h2>Select a project</h2><p>Choose an application project to create screens bound to its entity models.</p></section><section id="editor" hidden><h2 id="project-title"></h2><form id="screen-form"><label>Screen name<input name="name" required maxlength="120"></label><label>Alias<input name="alias" required pattern="[a-z][a-z0-9\-]{1,63}"></label><label>Type<select name="type"><option value="table">Table</option><option value="form">Form</option><option value="detail">Detail</option><option value="kanban">Kanban board</option><option value="calendar">Calendar</option><option value="search">Search</option><option value="approval">Approval</option><option value="chart">Chart</option><option value="dashboard">Dashboard</option></select></label><label>Data entity<select name="entity"></select></label><label>Visible columns (comma separated aliases)<input name="columns" placeholder="name, email, stage"></label><label>Editable form fields (comma separated aliases)<input name="formFields" placeholder="name, email"></label><label>Group field (kanban lane or chart category)<input name="groupField" placeholder="stage"></label><label>Chart numeric value field (optional; blank counts records)<input name="chartValueField" placeholder="amount"></label><label>Reusable components (comma separated aliases)<input name="components" placeholder="customer-card"></label><button class="primary" type="submit">Save screen</button><p id="status" role="status"></p></form><section id="preview" aria-live="polite"></section></section></main></div>
</div>
<style>
.sks{max-width:1320px;margin:2rem auto;padding:0 1.5rem;color:#17212b;font:15px/1.5 system-ui,sans-serif}.sks *{box-sizing:border-box}.sks header{display:flex;justify-content:space-between;align-items:center;padding:1rem 0 1.5rem;border-bottom:1px solid #dce3e8}.sks header small{color:#087f8c;letter-spacing:.12em;font-weight:700}.sks h1{font-size:2rem;margin:0}.sks h2{font-size:1.2rem}.sks p{color:#64727b}.sks .columns{display:grid;grid-template-columns:minmax(220px,290px) 1fr;gap:1.25rem;padding-top:1.25rem}.sks aside,.sks main{background:#fff;border:1px solid #dce3e8;border-radius:12px;padding:1.25rem;min-width:0}.sks label{display:grid;gap:.3rem;font-weight:600;margin:.75rem 0}.sks input,.sks select{width:100%;border:1px solid #b8c5cc;border-radius:7px;padding:.65rem;background:#fff;color:#17212b}.sks button{padding:.65rem 1rem;border:1px solid #b8c5cc;background:#fff;border-radius:7px;cursor:pointer;font-weight:650}.sks button:focus-visible,.sks input:focus-visible,.sks select:focus-visible{outline:3px solid #68c9d0;outline-offset:2px}.sks button.primary{background:#087f8c;border-color:#087f8c;color:white}.sks .item{display:block;width:100%;text-align:left;margin:.45rem 0;padding:.7rem;background:#f7f9fa;border:1px solid #e2e8ec;border-radius:8px}.sks table{border-collapse:collapse;width:100%;margin-top:1rem}.sks th,.sks td{text-align:left;padding:.65rem;border-bottom:1px solid #e2e8ec}.sks .lane{display:inline-block;vertical-align:top;min-width:190px;padding:.8rem;background:#f4f7f8;border-radius:8px;margin:.4rem}.sks .card{background:white;border:1px solid #dce3e8;border-radius:7px;padding:.6rem;margin:.4rem 0}@@media(max-width:760px){.sks .columns{grid-template-columns:1fr}.sks header{align-items:flex-start;flex-direction:column;gap:.7rem}}
</style>
<script>
(()=>{const api='/api/sitekit',projects=document.getElementById('projects'),screenList=document.getElementById('screen-list'),editor=document.getElementById('editor'),empty=document.getElementById('empty'),form=document.getElementById('screen-form'),status=document.getElementById('status');let project=null,entities=[];
async function req(url,options={}){const r=await fetch(url,options);if(!r.ok){const d=await r.json().catch(()=>({}));throw new Error(d.title||d.error||`Request failed (${r.status})`)}return r.status===204?null:r.json()}const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function choose(p){project=p;empty.hidden=true;editor.hidden=false;document.getElementById('project-title').textContent=p.name;entities=await req(`${api}/projects/${encodeURIComponent(p.id)}/entities`);form.elements.entity.innerHTML=entities.map(e=>`<option value="${esc(e.alias)}">${esc(e.name)} · ${esc(e.alias)}</option>`).join('')||'<option value="">Create an entity in Projects first</option>';await loadScreens()}
async function loadScreens(){const rows=await req(`${api}/projects/${encodeURIComponent(project.id)}/screens`);screenList.innerHTML=rows.length?rows.map(s=>`<button class="item" data-alias="${esc(s.alias)}"><strong>${esc(s.name)}</strong><br><small>${esc(s.type)} · ${esc(s.entityAlias||'no entity')}</small></button>`).join(''):'<p>No screens in this project yet.</p>';screenList.querySelectorAll('[data-alias]').forEach(b=>b.onclick=()=>edit(rows.find(s=>s.alias===b.dataset.alias)))}
function edit(s){form.elements.name.value=s.name;form.elements.alias.value=s.alias;form.elements.type.value=s.type;form.elements.entity.value=s.entityAlias||'';form.elements.columns.value=(s.columns||[]).join(', ');form.elements.formFields.value=(s.formFields||[]).join(', ');form.elements.groupField.value=s.groupField||'';form.elements.chartValueField.value=s.chartValueField||'';form.elements.components.value=(s.components||[]).join(', ');preview(s.alias)}
function split(value){return value.split(',').map(x=>x.trim()).filter(Boolean)}
function renderRecordEditor(target,result){const entity=result.entity;if(!entity)return;const screen=result.screen,records=result.records||[],permissions=result.allowedOperations||[],canCreate=permissions.includes('create')||permissions.includes('manage'),canUpdate=permissions.includes('update')||permissions.includes('manage'),canDelete=permissions.includes('delete')||permissions.includes('manage'),aliases=(screen.formFields||[]).length?screen.formFields:(screen.columns||[]).length?screen.columns:entity.fields.filter(field=>field.alias!=='id').map(field=>field.alias),specs=entity.fields.filter(field=>aliases.includes(field.alias));const list=document.createElement('section');list.innerHTML=`<h3>Records · ${esc(entity.name)}</h3>${records.length?records.map((record,index)=>`<article class="card"><strong>${esc(record.data.name||record.data.title||record.id)}</strong><div>${aliases.map(alias=>`<span>${esc(alias)}: ${esc(record.data[alias])} </span>`).join('')}</div>${canUpdate?`<button type="button" data-edit-record="${index}">Edit</button>`:''}${canDelete?` <button type="button" data-delete-record="${index}">Delete</button>`:''}</article>`).join(''):'<p>No records yet.</p>'}`;target.append(list);list.querySelectorAll('[data-delete-record]').forEach(button=>button.onclick=async()=>{const record=records[Number(button.dataset.deleteRecord)];if(!confirm('Delete this record?'))return;try{await req(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/records/${encodeURIComponent(record.id)}`,{method:'DELETE'});await preview(screen.alias)}catch(e){status.textContent=e.message}});const canWrite=canCreate||canUpdate;if(!canWrite){list.insertAdjacentHTML('beforeend','<p>Record changes require an explicit entity grant.</p>');return}const recordForm=document.createElement('form');recordForm.id='screen-record-editor';recordForm.innerHTML=`<h3>Record editor</h3><input name="recordId" type="hidden">${specs.map(field=>`<label>${esc(field.name)}${field.type==='json'||field.type==='relationships'?`<textarea data-record-field="${esc(field.alias)}" data-field-type="${field.type}" data-required="${field.required}" ${field.required?'required':''}></textarea>`:`<input data-record-field="${esc(field.alias)}" data-field-type="${field.type}" data-required="${field.required}" type="${field.type==='boolean'?'checkbox':field.type==='number'?'number':field.type==='email'?'email':field.type==='date'?'date':field.type==='datetime'?'datetime-local':'text'}" ${field.required?'required':''}>`}</label>`).join('')}<button class="primary" type="submit">${canCreate?'Create record':'Save changes'}</button> <button type="button" id="clear-screen-record">Clear</button><p id="screen-record-status" role="status"></p>`;target.append(recordForm);function fill(record){recordForm.elements.recordId.value=record?.id||'';recordForm.querySelectorAll('[data-record-field]').forEach(input=>{const value=record?.data?.[input.dataset.recordField];if(input.type==='checkbox')input.checked=value===true;else input.value=value===null||value===undefined?'':(typeof value==='object'?JSON.stringify(value):value)});recordForm.querySelector('[type="submit"]').textContent=record?'Save changes':(canCreate?'Create record':'Save changes');recordForm.querySelector('[type="submit"]').disabled=record?!canUpdate:!canCreate}list.querySelectorAll('[data-edit-record]').forEach(button=>button.onclick=()=>fill(records[Number(button.dataset.editRecord)]));recordForm.querySelector('#clear-screen-record').onclick=()=>fill(null);recordForm.onsubmit=async event=>{event.preventDefault();const id=recordForm.elements.recordId.value,data={};recordForm.querySelectorAll('[data-record-field]').forEach(input=>{{const spec=specs.find(field=>field.alias===input.dataset.recordField);let value=input.type==='checkbox'?input.checked:input.type==='number'&&input.value!==''?Number(input.value):input.value;if(input.value===''&&spec&&!spec.required&&input.type!=='checkbox')value=null;if(value!==null&&spec&&(spec.type==='json'||spec.type==='relationships'))value=JSON.parse(value);data[input.dataset.recordField]=value}});try{await req(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/records${id?`/${encodeURIComponent(id)}`:''}`,{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});status.textContent='Record saved.';await preview(screen.alias)}catch(e){document.getElementById('screen-record-status').textContent=e.message}}}
async function preview(alias){try{const result=await req(`${api}/projects/${encodeURIComponent(project.id)}/screens/${encodeURIComponent(alias)}/preview`);const target=document.getElementById('preview'),screen=result.screen,records=result.records||[],fields=screen.columns||[];if(screen.type==='chart'){const totals=new Map();for(const record of records){const label=String(record.data[screen.groupField]??'Unassigned'),raw=screen.chartValueField?Number(record.data[screen.chartValueField]||0):1;totals.set(label,(totals.get(label)||0)+(Number.isFinite(raw)?raw:0))}const rows=[...totals.entries()].sort((a,b)=>a[0].localeCompare(b[0])),max=Math.max(1,...rows.map(row=>row[1]));target.innerHTML='<h2>Preview · '+esc(screen.name)+'</h2><div role="img" aria-label="'+esc(screen.name)+' by '+esc(screen.groupField)+'">'+(rows.map(([label,value])=>'<div><strong>'+esc(label)+'</strong><progress max="'+max+'" value="'+Math.max(0,value)+'">'+esc(value)+'</progress> '+esc(value)+'</div>').join('')||'<p>No records yet.</p>')+'</div><table><caption>Chart values</caption><thead><tr><th scope="col">'+esc(screen.groupField)+'</th><th scope="col">Value</th></tr></thead><tbody>'+(rows.map(([label,value])=>'<tr><th scope="row">'+esc(label)+'</th><td>'+esc(value)+'</td></tr>').join('')||'<tr><td colspan="2">No data</td></tr>')+'</tbody></table>';renderRecordEditor(target,result);return}if(screen.type==='kanban'){const group=screen.groupField;const groups=[...new Set(records.map(r=>r.data[group]||'Unassigned'))];target.innerHTML=`<h2>Preview · ${esc(screen.name)}</h2>${(groups.length?groups:['No records']).map(g=>`<section class="lane"><strong>${esc(g)}</strong>${records.filter(r=>(r.data[group]||'Unassigned')===g).map(r=>`<article class="card">${fields.map(f=>`<div>${esc(r.data[f])}</div>`).join('')||esc(r.id)}</article>`).join('')}</section>`).join('')}`;renderRecordEditor(target,result);return}target.innerHTML=`<h2>Preview · ${esc(screen.name)} <small>(${records.length} records)</small></h2><table><thead><tr>${fields.map(f=>`<th>${esc((result.fields||[]).find(x=>x.alias===f)?.name||f)}</th>`).join('')}</tr></thead><tbody>${records.map(r=>`<tr>${fields.map(f=>`<td>${esc(r.data[f])}</td>`).join('')}</tr>`).join('')||`<tr><td colspan="${Math.max(1,fields.length)}">No records yet. Grant access and add records in Projects.</td></tr>`}</tbody></table>`;renderRecordEditor(target,result)}catch(e){status.textContent=e.message}}
document.getElementById('new-screen').onclick=()=>{if(!project){status.textContent='Select a project first.';return}form.reset();document.getElementById('preview').innerHTML=''};
form.onsubmit=async e=>{e.preventDefault();try{const screen={schemaVersion:1,projectId:project.id,alias:form.elements.alias.value,name:form.elements.name.value,type:form.elements.type.value,entityAlias:form.elements.entity.value||null,columns:split(form.elements.columns.value),formFields:split(form.elements.formFields.value),groupField:form.elements.groupField.value.trim()||null,chartValueField:form.elements.chartValueField.value.trim()||null,components:split(form.elements.components.value)};await req(`${api}/projects/${encodeURIComponent(project.id)}/screens/${encodeURIComponent(screen.alias)}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(screen)});status.textContent='Screen saved and connected to the project schema.';await loadScreens();await preview(screen.alias)}catch(e){status.textContent=e.message}};
req(`${api}/projects`).then(rows=>{projects.innerHTML=rows.map(p=>`<button class="item" data-project="${esc(p.id)}">${esc(p.name)} <small>· ${esc(p.category)}</small></button>`).join('')||'<p>No projects yet.</p>';projects.querySelectorAll('[data-project]').forEach(b=>b.onclick=()=>choose(rows.find(p=>p.id===b.dataset.project)).catch(e=>status.textContent=e.message))}).catch(e=>projects.textContent=e.message);
})();
</script>
