@{
    ViewData["Title"] = "Modules";
    Layout = "~/Views/Layouts/SiteKitStudio.cshtml";
}

<main class="skm"><header><div><small>SITEKIT STUDIO</small><h1>Modules</h1><p>Install reusable, integrity-checked SiteKit capabilities.</p></div></header>
<section><h2>Import a module package</h2><p>Only declarative JSON schemas, screens, workflows and Markdown documentation are accepted. Package code is never executed.</p><form id="import-form"><label>SiteKit module ZIP<input name="file" type="file" accept=".zip,application/zip" required></label><button class="primary">Verify and import</button></form><p id="message" role="status"></p></section>
<section><h2>Verified modules</h2><p>Removing a module detaches its version pin. Project schemas and existing business records are preserved.</p><div id="modules" aria-live="polite">Loading modules…</div></section></main>
<style>
.skm{max-width:1100px;margin:2rem auto;padding:0 1.5rem;color:#17212b;font:15px/1.5 system-ui,sans-serif}.skm *{box-sizing:border-box}.skm header{padding:1rem 0 1.5rem;border-bottom:1px solid #dce3e8}.skm header small{color:#087f8c;font-weight:700;letter-spacing:.12em}.skm h1{font-size:2rem;margin:0}.skm section{background:#fff;border:1px solid #dce3e8;border-radius:12px;margin:1.25rem 0;padding:1.25rem}.skm label{display:grid;gap:.4rem;margin:1rem 0;font-weight:600}.skm input,.skm select{border:1px solid #b8c5cc;border-radius:7px;padding:.7rem}.skm button{padding:.65rem 1rem;border:1px solid #b8c5cc;background:#fff;border-radius:7px;cursor:pointer}.skm button.primary{background:#087f8c;border-color:#087f8c;color:#fff}.skm article{border:1px solid #e0e7eb;border-radius:8px;padding:1rem;margin:.75rem 0}.skm article small{display:block;color:#64727b}.skm article form{display:flex;gap:.6rem;align-items:end;flex-wrap:wrap}.skm article label{min-width:220px}.skm p{color:#64727b}.skm button:focus-visible,.skm input:focus-visible,.skm select:focus-visible{outline:3px solid #68c9d0;outline-offset:2px}
</style>
<script>
(()=>{
 const host=document.getElementById('modules'),message=document.getElementById('message'),esc=value=>String(value??'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
 async function request(url,options={}){const response=await fetch(url,options);if(!response.ok){const problem=await response.json().catch(()=>({}));throw new Error(problem.title||problem.error||`Request failed (${response.status})`)}return response.status===204?null:response.json()}
 async function refresh(){
  try{
   const [modules,projects]=await Promise.all([request('/api/sitekit/modules'),request('/api/sitekit/projects')]);
   if(!modules.length){host.innerHTML='<p>No verified packages installed yet.</p>';return}
   host.innerHTML=modules.map(module=>{const pinnedByProject=projects.some(project=>project.modules?.includes(module.id)&&(!project.moduleVersions?.[module.id]||project.moduleVersions[module.id]===module.version));return `<article><strong>${esc(module.name)}</strong><small>${esc(module.id)} · v${esc(module.version)}</small><p>${esc(module.description||'')}</p><small>Capabilities: ${module.capabilities.map(esc).join(', ')||'declarative data'}</small><div><a href="/api/sitekit/modules/${encodeURIComponent(module.id)}/${encodeURIComponent(module.version)}/export">Export package</a></div>${pinnedByProject?'<small>This version is pinned by a project and cannot be deleted.</small>':`<button type="button" data-delete-package="true" data-module="${esc(module.id)}" data-version="${esc(module.version)}">Delete package version</button>`}${projects.map(project=>{const pinned=project.moduleVersions?.[module.id];const installed=project.modules?.includes(module.id);const label=pinned===module.version?'Installed in this project':pinned?`Upgrade from ${pinned}`:installed?`Pin and upgrade to ${module.version}`:`Install ${module.version}`;return `<form data-module="${esc(module.id)}" data-version="${esc(module.version)}" data-project="${esc(project.id)}" data-upgrade="${pinned||installed?'true':'false'}"><label>${esc(project.name)}<small>${esc(project.category)} · ${esc(project.id)}</small></label><button type="submit" ${pinned===module.version?'disabled':''}>${esc(label)}</button>${installed?`<button type="button" data-uninstall="true" data-module="${esc(module.id)}" data-project="${esc(project.id)}">Remove package</button>`:''}</form>`}).join('')}</article>`}).join('');
   host.querySelectorAll('form[data-module]').forEach(form=>form.onsubmit=async event=>{event.preventDefault();try{const action=form.dataset.upgrade==='true'?'upgrade':'install',result=await request(`/api/sitekit/modules/${encodeURIComponent(form.dataset.module)}/${encodeURIComponent(form.dataset.version)}/${action}/${encodeURIComponent(form.dataset.project)}`,{method:'POST'});message.textContent=`${form.dataset.module} ${action} succeeded for ${result.name}.`;await refresh()}catch(error){message.textContent=error.message}});
   host.querySelectorAll('button[data-uninstall]').forEach(button=>button.onclick=async()=>{const moduleId=button.dataset.module,projectId=button.dataset.project;if(!window.confirm(`Remove ${moduleId} from this project? Its schemas and existing records will be preserved.`))return;try{const result=await request(`/api/sitekit/modules/${encodeURIComponent(moduleId)}/uninstall/${encodeURIComponent(projectId)}`,{method:'DELETE'});message.textContent=`${moduleId} removed from ${result.name}. Project data was preserved.`;await refresh()}catch(error){message.textContent=error.message}});
   host.querySelectorAll('button[data-delete-package]').forEach(button=>button.onclick=async()=>{const moduleId=button.dataset.module,version=button.dataset.version;if(!window.confirm(`Permanently delete ${moduleId} v${version} from the local package registry? Project data is not affected.`))return;try{await request(`/api/sitekit/modules/${encodeURIComponent(moduleId)}/${encodeURIComponent(version)}`,{method:'DELETE'});message.textContent=`${moduleId} v${version} deleted from the package registry.`;await refresh()}catch(error){message.textContent=error.message}});
  }catch(error){host.textContent=error.message}
 }
 document.getElementById('import-form').onsubmit=async event=>{event.preventDefault();const input=event.currentTarget.elements.file;if(!input.files?.length)return;const body=new FormData();body.append('file',input.files[0]);try{const module=await request('/api/sitekit/modules/import',{method:'POST',body});message.textContent=`Verified ${module.name} v${module.version}.`;await refresh()}catch(error){message.textContent=error.message}};
 refresh();
})();
</script>
