@{
    ViewData["Title"] = "Projects";
    Layout = "~/Views/Layouts/FullWidth.cshtml";
}

<div class="skp" id="sitekit-projects">
    <header><div><small>SITEKIT STUDIO</small><h1>Projects</h1><p>Keep project configuration and component placements independent.</p><nav><a href="/studio/components">Components</a> · <a href="/studio/modules">Modules</a></nav></div><button id="new-project" class="primary">New project</button></header>
    <div class="columns"><aside><h2>Your projects</h2><div id="projects-list" aria-live="polite">Loading…</div></aside><main><div id="empty"><h2>Select a project</h2><p>Create a project or choose one to manage its components.</p></div>
        <section id="project-panel" hidden><h2 id="project-title"></h2><p id="project-description"></p><button id="generate-project" type="button">Generate deployable project</button><p id="generated-project-status" role="status"></p><h3>Shared components placed in this project</h3><div id="placements" aria-live="polite"></div>
            <form id="placement-form"><h3>Add a component</h3><label>Component<select name="component" required></select></label><label>Component data (JSON)<textarea name="data" required>{}</textarea></label><details><summary>Project appearance override</summary><div class="appearance"><label>Text color<input name="color" type="color" value="#17212b"></label><label>Background<input name="backgroundColor" type="color" value="#ffffff"></label><label>Border color<input name="borderColor" type="color" value="#dce3e8"></label><label>Corner radius<input name="borderRadius" value="12px" pattern="(?:0|[0-9]{1,3}(?:\.[0-9]{1,2})?(?:px|rem|em|%))"></label><label>Padding<input name="padding" value="16px" pattern="(?:0|[0-9]{1,3}(?:\.[0-9]{1,2})?(?:px|rem|em|%))"></label></div></details><button class="primary" type="submit">Add placement</button></form>
            <section class="entity-studio"><h3>Business data models</h3><p>Operational data is stored independently from Umbraco content.</p><div id="entities-list" aria-live="polite"></div><details><summary>Create or update an entity schema</summary><form id="entity-form"><label>Entity definition JSON<textarea name="definition" spellcheck="false" required>{"schemaVersion":1,"projectId":"","alias":"customer","name":"Customer","version":1,"permissions":["read","create","update","delete"],"fields":[{"alias":"id","name":"Id","type":"text","required":true,"unique":true},{"alias":"name","name":"Name","type":"text","required":true,"maximumLength":160},{"alias":"email","name":"Email","type":"email","required":true,"unique":true}]}</textarea></label><button class="primary" type="submit">Save data model</button></form></details><div id="entity-permissions"></div><div id="entity-records"></div></section>
        </section>
        <section id="create-panel" hidden><h2>Create a project</h2><form id="project-form"><label>Name<input name="name" required maxlength="120"></label><label>Project id<input name="id" required pattern="[a-z][a-z0-9-]{1,63}" maxlength="64"></label><label>Category<select name="category"><option value="website">Website</option><option value="application">Business application</option><option value="combined">Website and application</option><option value="api">API first</option><option value="content">Content management</option></select></label><label>Theme<input name="theme" value="default" required pattern="[a-z][a-z0-9-]{1,63}"></label><div class="appearance"><label>Primary color<input name="primaryColor" type="color" value="#087f8c"></label><label>Surface color<input name="surfaceColor" type="color" value="#ffffff"></label><label>Text color<input name="textColor" type="color" value="#17212b"></label><label>Font<select name="fontFamily"><option>system</option><option>serif</option><option>sans-serif</option><option>monospace</option></select></label><label>Corner radius<input name="radius" value="12px" pattern="(?:0|[0-9]{1,2}(?:\.[0-9]{1,2})?(?:px|rem|em))"></label></div><label>Description<textarea name="description" maxlength="2000"></textarea></label><button class="primary" type="submit">Create project</button></form></section>
        <p id="project-status" role="status"></p>
    </main></div>
</div>
<style>
.skp{max-width:1320px;margin:2rem auto;padding:0 1.5rem;color:#17212b;font:15px/1.5 system-ui,sans-serif}.skp *{box-sizing:border-box}.skp header{display:flex;justify-content:space-between;align-items:center;padding:1rem 0 1.5rem;border-bottom:1px solid #dce3e8}.skp header small{color:#087f8c;letter-spacing:.12em;font-weight:700}.skp h1{font-size:2rem;margin:0}.skp h2,.skp h3{font-size:1.2rem;margin:0 0 .8rem}.skp p{color:#64727b}.skp .columns{display:grid;grid-template-columns:minmax(230px,300px) 1fr;gap:1.25rem;padding-top:1.25rem}.skp aside,.skp main{background:#fff;border:1px solid #dce3e8;border-radius:12px;padding:1.25rem;min-width:0}.skp label{display:grid;gap:.3rem;font-weight:600;margin:.7rem 0}.skp input,.skp select,.skp textarea{width:100%;border:1px solid #b8c5cc;border-radius:7px;padding:.65rem;background:#fff;color:#17212b}.skp textarea{min-height:5rem}.skp button{padding:.65rem 1rem;border:1px solid #b8c5cc;background:#fff;border-radius:7px;cursor:pointer;font-weight:650}.skp button:focus-visible,.skp input:focus-visible,.skp select:focus-visible,.skp textarea:focus-visible{outline:3px solid #68c9d0;outline-offset:2px}.skp button.primary{background:#087f8c;border-color:#087f8c;color:white}.skp .project-item,.skp .placement-item{display:block;width:100%;text-align:left;margin:.5rem 0;padding:.75rem;background:#f7f9fa;border:1px solid #e2e8ec;border-radius:8px}.skp .project-item small{display:block;color:#64727b}.skp form{max-width:780px}.skp details{padding:1rem;border:1px solid #dce3e8;border-radius:8px;margin:1rem 0}.skp summary{cursor:pointer;font-weight:700}.skp .appearance{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.skp .placement-item>strong{display:block;margin-bottom:.2rem}.skp .placement-item>small{display:block;color:#64727b;margin-bottom:.6rem}.skp .preview{padding:1rem;margin:.5rem 0;border:1px dashed #bac7ce;border-radius:8px}.skp .entity-studio{margin-top:2rem;border-top:1px solid #dce3e8;padding-top:1.5rem}.skp #project-status{min-height:1.5rem}@media(max-width:760px){.skp .columns{grid-template-columns:1fr}.skp header{align-items:flex-start;flex-direction:column;gap:.7rem}.skp .appearance{grid-template-columns:1fr 1fr}}
</style>
<script>
(()=>{
 const api='/api/sitekit',list=document.getElementById('projects-list'),status=document.getElementById('project-status');let project=null,components=[];
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 async function request(url,options={}){const r=await fetch(url,options);if(!r.ok){const d=await r.json().catch(()=>({}));throw new Error(d.title||d.error||`Request failed (${r.status})`)}return r.status===204?null:r.json()}
 async function refresh(){const projects=await request(`${api}/projects`);components=await request(`${api}/components`);list.innerHTML=projects.length?projects.map(p=>`<button class="project-item" data-id="${esc(p.id)}"><strong>${esc(p.name)}</strong><small>${esc(p.category)} · ${esc(p.id)}</small></button>`).join(''):'<p>No projects yet.</p>';list.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>selectProject(projects.find(p=>p.id===b.dataset.id)));const select=document.querySelector('[name="component"]');select.innerHTML=components.map(c=>`<option value="${esc(c.alias)}">${esc(c.name)} · v${esc(c.version)}</option>`).join('')||'<option value="">Create a component first</option>';}
 async function selectProject(p){project=p;document.getElementById('empty').hidden=true;document.getElementById('create-panel').hidden=true;document.getElementById('project-panel').hidden=false;document.getElementById('project-title').textContent=p.name;document.getElementById('project-description').textContent=p.description||`${p.category} project · ${p.id}`;document.querySelector('#entity-form [name="definition"]').value=JSON.stringify({schemaVersion:1,projectId:p.id,alias:'customer',name:'Customer',version:1,permissions:['read','create','update','delete'],fields:[{alias:'id',name:'Id',type:'text',required:true,unique:true},{alias:'name',name:'Name',type:'text',required:true,maximumLength:160},{alias:'email',name:'Email',type:'email',required:true,unique:true}]},null,2);await Promise.all([loadPlacements(),loadEntities()]);}
 async function loadPlacements(){const target=document.getElementById('placements');try{const entries=await request(`${api}/projects/${encodeURIComponent(project.id)}/placements`);if(!entries.length){target.innerHTML='<p>No component placements in this project yet.</p>';return;}target.innerHTML='';for(const item of entries){const row=document.createElement('article');row.className='placement-item';const comp=components.find(c=>c.alias===item.componentAlias);row.innerHTML=`<strong>${esc(comp?.name||item.componentAlias)}</strong><small>Shared definition · ${esc(item.version||'latest')} · ${esc(item.id)}</small><div class="preview"></div><button data-delete="${esc(item.id)}">Remove placement</button>`;const rendered=await fetch(`${api}/projects/${encodeURIComponent(project.id)}/placements/${encodeURIComponent(item.id)}/preview`);if(rendered.ok)row.querySelector('.preview').innerHTML=await rendered.text();target.append(row);}target.querySelectorAll('[data-delete]').forEach(b=>b.onclick=async()=>{try{await request(`${api}/projects/${encodeURIComponent(project.id)}/placements/${encodeURIComponent(b.dataset.delete)}`,{method:'DELETE'});await loadPlacements();}catch(e){status.textContent=e.message}});}catch(e){status.textContent=e.message}}
 async function loadEntities(){const target=document.getElementById('entities-list');try{const entities=await request(`${api}/projects/${encodeURIComponent(project.id)}/entities`);target.innerHTML=entities.length?entities.map(e=>`<button class="project-item" data-entity="${esc(e.alias)}"><strong>${esc(e.name)}</strong><small>v${esc(e.version)} · ${e.fields.length} fields</small></button>`).join(''):'<p>No business data models yet.</p>';target.querySelectorAll('[data-entity]').forEach(b=>b.onclick=()=>openEntity(entities.find(e=>e.alias===b.dataset.entity)));}catch(e){target.textContent=e.message}}
 async function openEntity(entity){document.querySelector('#entity-form [name="definition"]').value=JSON.stringify(entity,null,2);await loadRecords(entity);await loadGrants(entity)}
 async function loadRecords(entity){const target=document.getElementById('entity-records');try{const records=await request(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/records`);target.innerHTML=`<h4>${esc(entity.name)} records (${records.length})</h4><form id="record-form"><input name="id" type="hidden"><label>Record data JSON<textarea name="data" id="new-record-data" required>{}</textarea></label><button class="primary" type="submit">Create record</button><button id="cancel-record-edit" type="button" hidden>Cancel edit</button></form><div>${records.map(r=>`<details><summary>${esc(r.data.name||r.data.email||r.id)}</summary><pre>${esc(JSON.stringify(r.data,null,2))}</pre><button data-record-edit="${esc(r.id)}">Edit record</button> <button data-record-delete="${esc(r.id)}">Delete record</button></details>`).join('')}</div>`;const form=document.getElementById('record-form');form.onsubmit=async event=>{event.preventDefault();try{const id=form.elements.id.value,data=JSON.parse(form.elements.data.value),url=`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/records${id?`/${encodeURIComponent(id)}`:''}`;await request(url,{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});await loadRecords(entity)}catch(e){status.textContent=e.message}};document.getElementById('cancel-record-edit').onclick=()=>{form.reset();form.elements.id.value='';form.querySelector('[type=submit]').textContent='Create record';document.getElementById('cancel-record-edit').hidden=true};target.querySelectorAll('[data-record-edit]').forEach(b=>b.onclick=()=>{const record=records.find(r=>r.id===b.dataset.recordEdit);form.elements.id.value=record.id;form.elements.data.value=JSON.stringify(record.data,null,2);form.querySelector('[type=submit]').textContent='Save changes';document.getElementById('cancel-record-edit').hidden=false});target.querySelectorAll('[data-record-delete]').forEach(b=>b.onclick=async()=>{try{await request(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/records/${encodeURIComponent(b.dataset.recordDelete)}`,{method:'DELETE'});await loadRecords(entity)}catch(e){status.textContent=e.message}});}catch(e){target.innerHTML=`<p>Record access requires an explicit permission grant. ${esc(e.message)}</p>`}}
 async function loadGrants(entity){const target=document.getElementById('entity-permissions');try{const grants=await request(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/permissions`);target.innerHTML=`<h4>Access grants</h4><div>${grants.map(g=>`<p>${esc(g.principal)} · ${g.operations.map(esc).join(', ')}</p>`).join('')}</div><form id="grant-form"><label>Account email<input name="principal" type="email" required></label><label>Operations<input name="operations" value="read,create,update,delete" required></label><button type="submit">Save access grant</button></form>`;document.getElementById('grant-form').onsubmit=async ev=>{ev.preventDefault();const f=ev.currentTarget;try{await request(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(entity.alias)}/permissions`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({projectId:project.id,entityAlias:entity.alias,principal:f.elements.principal.value,operations:f.elements.operations.value.split(',').map(x=>x.trim())})});await loadGrants(entity)}catch(e){status.textContent=e.message}}}catch(e){target.textContent=e.message}}
 document.getElementById('entity-form').onsubmit=async e=>{e.preventDefault();try{const definition=JSON.parse(e.currentTarget.elements.definition.value);definition.projectId=project.id;await request(`${api}/projects/${encodeURIComponent(project.id)}/entities/${encodeURIComponent(definition.alias)}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(definition)});status.textContent='Entity schema saved. Increment its version when changing its schema.';await loadEntities()}catch(err){status.textContent=err.message}};
 document.getElementById('generate-project').onclick=async()=>{const out=document.getElementById('generated-project-status');try{const generated=await request(`${api}/projects/${encodeURIComponent(project.id)}/generate`,{method:'POST'});out.textContent=`Generated in ${generated.directory}. Build: ${generated.buildCommand}`}catch(e){out.textContent=e.message}};
 document.getElementById('new-project').onclick=()=>{document.getElementById('empty').hidden=true;document.getElementById('project-panel').hidden=true;document.getElementById('create-panel').hidden=false;};
 const pf=document.getElementById('project-form');pf.elements.name.oninput=()=>{if(!pf.elements.id.dataset.touched)pf.elements.id.value=pf.elements.name.value.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,64)};pf.elements.id.oninput=()=>pf.elements.id.dataset.touched='1';
 pf.onsubmit=async e=>{e.preventDefault();const p={schemaVersion:1,id:pf.elements.id.value,name:pf.elements.name.value,category:pf.elements.category.value,theme:pf.elements.theme.value,themeSettings:{primaryColor:pf.elements.primaryColor.value,surfaceColor:pf.elements.surfaceColor.value,textColor:pf.elements.textColor.value,fontFamily:pf.elements.fontFamily.value,radius:pf.elements.radius.value},description:pf.elements.description.value,modules:[],components:[],entities:[]};try{await request(`${api}/projects/${encodeURIComponent(p.id)}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)});status.textContent='Project created.';await refresh();await selectProject(p);}catch(err){status.textContent=err.message}};
 document.getElementById('placement-form').onsubmit=async e=>{e.preventDefault();if(!project)return;try{const form=e.currentTarget;const component=components.find(c=>c.alias===form.elements.component.value);if(!component)throw new Error('Create a reusable component before placing it.');const data=JSON.parse(form.elements.data.value);const placement={id:`placement-${Date.now()}`,componentAlias:component.alias,version:component.version,data,appearance:{color:form.elements.color.value,backgroundColor:form.elements.backgroundColor.value,borderColor:form.elements.borderColor.value,borderRadius:form.elements.borderRadius.value,padding:form.elements.padding.value}};await request(`${api}/projects/${encodeURIComponent(project.id)}/placements`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(placement)});status.textContent='Project placement saved. Its appearance is independent of other projects.';await loadPlacements();}catch(err){status.textContent=err.message}};
 refresh().catch(e=>{list.textContent=e.message;status.textContent=e.message});
})();
</script>
